{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Position",
  "type": "object",
  "required": ["positionId", "customerId", "symbol", "shares"],
  "properties": {
    "positionId": { "type": "integer" },
    "customerId": { "type": "integer" },
    "name": { "type": ["string", "null"] },
    "symbol": { "type": "string" },
    "shares": { "type": "number" },
    "purchasePrice": { "type": "number" }
  }
}
