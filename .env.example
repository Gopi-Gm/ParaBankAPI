# 🌍 ENVIRONMENT
APP_ENV=qa

### 🔌 PARABANK REST API CONFIGURATION ###
API_BASE_URL=https://parabank.parasoft.com/parabank/services/bank
# Optional post-test delay (ms) to avoid Cloudflare 429 rate limits (defaults: 1200 local, 2000 CI, 0 localhost)
API_PACING_MS=
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo
CUSTOMER_ID=12212
PRIMARY_ACCOUNT_ID=12345
SECONDARY_ACCOUNT_ID=12456
LOAN_PROVIDER=funds

### 🔗 API CHAINING & TRANSACTION PARAMS ###
DEPOSIT_AMOUNT=200.00
WITHDRAW_AMOUNT=25.00
TRANSFER_AMOUNT=50.00
BILLPAY_AMOUNT=40.00
LOAN_AMOUNT=1000
LOAN_DOWN_PAYMENT=250
STOCK_SYMBOL=MSFT
STOCK_NAME=Microsoft Corp
STOCK_SHARES=5
STOCK_PRICE=320.00

### 🤖 GENAI EVALS & GUARDRAILS CONFIGURATION ###
AI_EVAL_PROVIDER=heuristic-fallback
AI_EVAL_API_KEY=
AI_EVAL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
