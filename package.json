{
  "name": "parabank-api-playwright-automation",
  "version": "1.0.0",
  "description": "ParaBank REST API Playwright + TypeScript Automation Framework",
  "main": "index.js",
  "keywords": [
    "parabank",
    "playwright",
    "typescript",
    "api-testing"
  ],
  "author": "Gopi Mohan",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "allure-playwright": "^3.13.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "luxon": "^3.7.2",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:api": "playwright test --grep @api",
    "test:master": "playwright test --grep @master",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:security": "playwright test --grep @security",
    "test:perf": "playwright test --grep @perf",
    "test:schema": "playwright test --grep @schema",
    "test:ai": "playwright test tests/ai",
    "test:guardrails": "playwright test tests/ai/guardrails.spec.ts",
    "test:hallucination": "playwright test tests/ai/hallucination.spec.ts",
    "test:evals": "playwright test tests/ai/evals.spec.ts",
    "test:generation": "npm --prefix api-test-case-generation test",
    "report:generation": "npm --prefix api-test-case-generation run report"
  }
}
